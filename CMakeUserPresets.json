{
    "version": 4,
    "vendor": {
        "conan": {}
    },
    "include": [
        "cmake-build-debug/CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug (local)",
            "inherits": "conan-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "/run/host/usr/bin/clang++",
                "CMAKE_C_COMPILER": "/run/host/usr/bin/clang"
            }
        }
    ]
}